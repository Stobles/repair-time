---
import type { HTMLAttributes } from "astro/types";
import { ChevronDown } from "lucide-astro";
import { cn } from "@/shared/lib/utils";

interface Props extends HTMLAttributes<"details"> {
  number: string;
  question: string;
  size?: "default" | "compact";
}

const { number, question, size = "default", class: className, ...attributes } = Astro.props;
const compact = size === "compact";
---

<details
  {...attributes}
  class={cn(
    "group/accordion border bg-background-base",
    compact
      ? "rounded-lg border-border-default shadow-xs l:rounded-xl l:shadow-none l:open:border-border-accent/35 l:open:shadow-ui-accordion-open"
      : "rounded-xl border-ui-accordion-border/80 open:border-border-accent/35 open:shadow-ui-accordion-open",
    "motion-safe:supports-[interpolate-size:allow-keywords]:[interpolate-size:allow-keywords] motion-safe:supports-[interpolate-size:allow-keywords]:[&::details-content]:overflow-clip motion-safe:supports-[interpolate-size:allow-keywords]:[&::details-content]:[block-size:0] motion-safe:supports-[interpolate-size:allow-keywords]:open:[&::details-content]:[block-size:auto] motion-safe:supports-[interpolate-size:allow-keywords]:[&::details-content]:[transition:block-size_200ms_ease-out,content-visibility_200ms_allow-discrete]",
    className,
  )}
>
  <summary class:list={[
    "ui-focus flex cursor-pointer list-none select-none items-center text-ui-accordion-heading [&::-webkit-details-marker]:hidden",
    compact
      ? "gap-ui-inset rounded-lg p-16px text-tablet-title-medium l:gap-12px l:rounded-xl l:p-24px l:text-desktop-title-medium"
      : "gap-[clamp(0.5rem,2vw,1.25rem)] rounded-xl p-[clamp(1rem,3vw,var(--spacing-ui-wide-inset))] text-mobile-h2",
  ]}>
    <span aria-hidden="true" class:list={[
      "shrink-0 place-items-center",
      compact
        ? "hidden size-24px rounded-md bg-stone-100 text-tablet-title-small text-stone-600 sm:grid sm:max-l:group-open/accordion:bg-background-accent sm:max-l:group-open/accordion:text-text-inverse l:size-32px l:border l:border-border-accent-subtle l:bg-background-accent-subtle l:text-mobile-title-large l:text-text-accent"
        : "grid size-10 rounded-lg border border-border-accent-subtle bg-background-accent-subtle text-mobile-title-large text-text-accent",
    ]}>
      {number}
    </span>
    <span class="min-w-0 grow wrap-anywhere">{question}</span>
    <span class:list={[
      "grid shrink-0 place-items-center rounded-full",
      compact
        ? "size-16px text-stone-400 max-l:group-open/accordion:text-text-accent l:size-32px l:bg-ui-accordion-divider l:text-text-tertiary l:group-open/accordion:bg-background-accent l:group-open/accordion:text-text-inverse"
        : "size-10 bg-ui-accordion-divider text-text-tertiary group-open/accordion:bg-background-accent group-open/accordion:text-text-inverse",
    ]}>
      <ChevronDown
        aria-hidden="true"
        focusable="false"
        class="size-16px motion-safe:transition-transform motion-safe:duration-200 group-open/accordion:rotate-180"
      />
    </span>
  </summary>
  <div class:list={[
    "border-t animate-none text-text-secondary motion-safe:not-supports-[interpolate-size:allow-keywords]:group-open/accordion:animate-in motion-safe:fade-in-0 motion-safe:duration-200",
    compact
      ? "border-border-default px-16px pt-4px pb-16px text-tablet-body-medium l:px-24px l:pt-8px l:pb-24px l:text-desktop-body-small"
      : "mt-4px border-ui-accordion-divider px-[clamp(1rem,3vw,var(--spacing-ui-wide-inset))] pt-8px pb-[clamp(1rem,3vw,var(--spacing-ui-wide-inset))] text-desktop-body-regular",
  ]}>
    <slot />
  </div>
</details>
