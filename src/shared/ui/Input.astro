---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/shared/lib/utils";

interface Props extends HTMLAttributes<"input"> {
  id: string;
  label: string;
  type?: "text" | "tel" | "email" | "search" | "url" | "password";
}

const { id, label, type = "text", class: className, ...attributes } = Astro.props;
---

<div class="grid min-w-0 gap-ui-gutter">
  <label for={id} class="ui-field-label">
    {label}{attributes.required && <span class="text-text-accent" aria-hidden="true"> *</span>}
  </label>
  <input
    {...attributes}
    {id}
    {type}
    class={cn(
      "ui-field-surface h-ui-field px-16px text-placeholder placeholder:text-text-tertiary",
      className,
    )}
  />
</div>
