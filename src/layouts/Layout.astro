---
import "../styles/global.css";

interface Props {
	title?: string;
	lang?: string;
}

const { title = "Astro Basics", lang = "en" } = Astro.props;
---

<!doctype html>
<html {lang} class="h-full w-full">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="flex flex-col m-0 h-full w-full">
		<slot />
	</body>
</html>
