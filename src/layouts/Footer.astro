---
import Container from "@/shared/components/Container.astro";
import Logo from "@/shared/ui/Logo.astro";

interface Props {
  companyName: string;
  phone: string;
  email: string;
  city: string;
  sections: readonly { label: string; id: string }[];
  requisites: {
    proprietorName: string;
    inn: string;
    ogrnip: string;
    registrationAuthority: string;
    isExample: boolean;
  };
  privacyHref?: string;
}

const { companyName, phone, email, city, sections, requisites, privacyHref } = Astro.props;
const year = new Date().getFullYear();
const phoneHref = `tel:${phone.replace(/[^+\d]/g, "")}`;
const policyHref = privacyHref?.trim();
const linkClass = "ui-focus rounded-sm transition-colors hover:text-text-accent-dark";
---

<footer class="bg-background-subtle sm:border-t sm:border-border-default">
  <Container class="py-24px l:py-32px">
    <div class="grid gap-24px wrap-anywhere sm:max-l:grid-cols-2 l:grid-cols-4 l:gap-x-32px">
      <div class="min-w-0 l:col-span-2">
        <Logo {companyName} />

        <p class="mt-12px max-w-md text-desktop-body-small text-text-tertiary l:text-text-secondary">
          Генеральный подрядчик по капитальному ремонту, реконструкции и Fit-Out отделке коммерческой и элитной жилой недвижимости в Донецке и Мариуполе с 2012 года.
        </p>

        <section id="company-details" tabindex="-1" aria-labelledby="footer-requisites" class="mt-16px max-w-md">
          <h2 id="footer-requisites" class="text-desktop-title-small text-text-primary">
            {requisites.isExample ? "Тестовые реквизиты" : "Реквизиты ИП"}
          </h2>
          <p class="mt-8px text-desktop-body-small text-text-secondary">ИП {requisites.proprietorName}</p>
          <dl class="mt-4px grid gap-y-4px text-desktop-body-small text-text-tertiary">
            <div class="flex flex-wrap gap-x-4px">
              <dt>ИНН</dt>
              <dd>{requisites.inn}</dd>
            </div>
            <div class="flex flex-wrap gap-x-4px">
              <dt>ОГРНИП</dt>
              <dd>{requisites.ogrnip}</dd>
            </div>
          </dl>
        </section>
      </div>

      <div class="grid min-w-0 content-start gap-24px l:contents">
        <nav aria-labelledby="footer-sections" class="min-w-0">
          <h2 id="footer-sections" class="text-desktop-title-small text-text-primary">Разделы</h2>
          <ul class="mt-8px grid gap-ui-gutter text-desktop-body-small text-text-tertiary l:text-text-secondary">
            {sections.map(({ label, id }) => (
              <li class="min-h-[17px]">
                <a href={`#${id}`} class:list={[linkClass]}>{label}</a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="min-w-0">
          <h2 class="text-desktop-title-small text-text-primary">Контакты</h2>
          <address class="mt-8px grid justify-items-start gap-ui-gutter not-italic l:gap-ui-inset">
            <a href={phoneHref} class:list={[linkClass, "max-w-full text-tablet-title-medium text-text-primary l:text-desktop-title-medium"]}>{phone}</a>
            <p class="text-desktop-body-small text-text-tertiary">{city}</p>
            <a href={`mailto:${email}`} class:list={[linkClass, "max-w-full text-desktop-body-small text-text-tertiary"]}>{email}</a>
          </address>
        </div>
      </div>
    </div>

    <div class="mt-24px flex flex-col gap-x-24px gap-y-8px border-t border-border-default pt-16px text-desktop-body-extra-small wrap-anywhere text-text-tertiary sm:flex-row sm:flex-wrap sm:items-center sm:justify-between l:mt-32px l:pt-24px">
      <p>© {year} «{companyName}»</p>
      {policyHref && <a href={policyHref} class={linkClass}>Политика конфиденциальности</a>}
    </div>
  </Container>
</footer>
