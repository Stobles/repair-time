---
import { Button } from "@/shared/ui/button";
import Checkbox from "@/shared/ui/Checkbox.astro";
import { Dropdown } from "@/shared/ui/Dropdown";
import Input from "@/shared/ui/Input.astro";
import Textfield from "@/shared/ui/Textfield.astro";

import { MessageSquareText } from "lucide-react";

interface Props {
  id: string;
  phone: string;
  telegramUrl: string;
}

const { id, phone, telegramUrl } = Astro.props;
const phoneHref = `tel:${phone.replace(/[^+\d]/g, "")}`;
const propertyTypes = [
  { value: "apartment", label: "Квартира или апартаменты" },
  { value: "house", label: "Загородный дом" },
  { value: "commercial", label: "Коммерческое помещение" },
  { value: "other", label: "Другое" },
];
---

<div class="grid gap-24px">
  <form data-callback-form method="post" class="grid min-w-0 gap-16px">
    <div class="grid min-w-0 grid-cols-[repeat(auto-fit,minmax(min(100%,13rem),1fr))] gap-16px">
      <Input id={`${id}-name`} name="name" label="ВАШЕ ИМЯ" placeholder="Константин" autocomplete="name" />
      <Input id={`${id}-phone`} name="phone" label="ТЕЛЕФОН" type="tel" placeholder="+7 (___) ___-__-__" autocomplete="tel" required />
    </div>
    <Dropdown
      client:load
      id={`${id}-property`}
      name="property"
      label="ТИП ОБЪЕКТА"
      options={propertyTypes}
      defaultValue="apartment"
    />
    <Textfield
      id={`${id}-message`}
      name="message"
      label="СООБЩЕНИЕ ИЛИ ОРИЕНТИРОВОЧНАЯ ПЛОЩАДЬ"
      placeholder="Укажите адрес, площадь или пожелания к ремонту"
    />
    <Checkbox id={`${id}-consent`} name="consent" required>
      Согласен на обработку персональных данных для обратного звонка *
    </Checkbox>
    <Button type="submit" leftIcon="send" rightIcon={false} className="w-full">
      ОТПРАВИТЬ ЗАЯВКУ
    </Button>
    <output class="empty:hidden text-desktop-body-medium text-text-accent-dark"></output>
  </form>
  <div class="flex flex-wrap items-center justify-between gap-8px border-t border-border-default pt-16px">
    <a href={telegramUrl} class="flex gap-2 items-center ui-focus rounded-sm text-desktop-title-extra-small text-functional-telegram hover:underline">
      <MessageSquareText aria-hidden="true" className="size-3 shrink-0" />
      Написать в Telegram
    </a>
    <a href={phoneHref} class="ui-focus rounded-sm text-desktop-title-small text-text-primary hover:text-text-accent-dark">
      {phone}
    </a>
  </div>
</div>

<script>
  document.addEventListener("submit", (event) => {
    const form = event.target;
    if (!(form instanceof HTMLFormElement) || !form.hasAttribute("data-callback-form")) return;

    event.preventDefault();
    const feedback = form.querySelector("output");
    if (feedback) feedback.value = "Отправка через сайт пока недоступна. Позвоните нам или напишите в Telegram.";
  });
</script>
