---
import CardSlider from "@/shared/ui/CardSlider.astro";
import type { Review } from "../types/Review";
import ReviewCard from "./ReviewCard.astro";

interface Props {
  reviews: readonly Review[];
}

const { reviews } = Astro.props;
---

<CardSlider
  count={reviews.length}
  labels={{
    previous: "Предыдущий отзыв",
    next: "Следующий отзыв",
    item: "отзыв",
    single: "Отзыв",
    multiple: "Отзывы",
  }}
>
  {reviews.map((review) => (
    <li class="swiper-slide grid min-w-0 shrink-0">
      <ReviewCard {review} />
    </li>
  ))}
</CardSlider>
