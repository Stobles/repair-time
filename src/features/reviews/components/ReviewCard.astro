---
import { Star } from "lucide-astro";
import { ReviewQuote } from "./ReviewQuote";
import type { Review } from "../types/Review";

interface Props {
  review: Review;
}

const avatarColors = {
  dark: "l:bg-background-inverse",
  accent: "l:bg-background-accent",
  muted: "l:bg-text-secondary",
};

const { author, initials, avatarColor, rating, quote, details } = Astro.props.review;
---

<article class="flex min-w-0 flex-col gap-8px rounded-lg border border-border-default bg-background-base p-12px shadow-xs sm:p-16px l:min-h-[300px] l:gap-ui-inset l:rounded-xl l:p-24px">
  <div class="order-last mt-auto flex min-w-0 items-center gap-ui-inset border-t border-border-default pt-8px l:gap-12px l:border-background-inactive l:pt-16px">
    <span class:list={[
      "grid size-7 shrink-0 place-items-center rounded-full bg-text-primary text-tablet-title-small text-text-inverse l:size-40px l:text-desktop-body-medium l:font-bold",
      avatarColors[avatarColor],
    ]} aria-hidden="true">{initials}</span>
    <div class="min-w-0">
      <p class="text-tablet-title-small wrap-anywhere text-text-primary l:text-desktop-title-small l:text-background-inverse">{author}</p>
      <p class="text-tablet-body-small wrap-anywhere text-text-tertiary l:font-golos-text l:text-xs/4.5">
        {details}
      </p>
    </div>
  </div>

  <div class="flex shrink-0 items-center text-functional-rating max-l:h-4 l:gap-0.5" role="img" aria-label={`Оценка ${rating} из 5`}>
    {Array.from({ length: rating }, () => (
      <Star class="size-3 fill-current l:size-[15px]" aria-hidden="true" />
    ))}
  </div>

  <ReviewQuote client:visible={{ rootMargin: "200px" }} {author} {details} {quote} />
</article>
