---
import Layout from "@/layouts/Layout.astro";
import Footer from "@/layouts/Footer.astro";
import Header from "@/layouts/Header/Header.astro";
import WhyChooseUs from "@/sections/WhyChooseUs/WhyChooseUs.astro";
import WorkProcess from "@/sections/WorkProcess/WorkProcess.astro";
import Faq from "@/sections/Faq/Faq.astro";

const companyName = "Время ремонта";
const phone = "+7 (949) 811 94 21";
const phoneNumber = phone.replace(/[^+\d]/g, "");
const telegramUrl = `https://t.me/${phoneNumber}`;
const email = "info@vremyaremonta.ru";
const sections = [
  { id: "portfolio", label: "Портфолио" },
  { id: "about", label: "О компании" },
  { id: "reviews", label: "Отзывы" },
  { id: "faq", label: "FAQ" },
  { id: "contacts", label: "Контакты" },
];
const footerSections = [
  { id: "portfolio", label: "Портфолио" },
  { id: "about", label: "О компании" },
  { id: "reviews", label: "Отзывы" },
  { id: "faq", label: "Ответы на частые вопросы" },
  { id: "contacts", label: "Контакты" },
];
const advantages = [
  {
    icon: "warranty",
    title: "Гарантия 5 лет по договору",
    description: "Бесплатный оперативный выезд и устранение любых скрытых дефектов в течение 48 часов после обращения.",
    caption: "ОФИЦИАЛЬНЫЙ ПУНКТ ДОГОВОРА",
  },
  {
    icon: "schedule",
    title: "Соблюдение сроков до 1 дня",
    description: "Фиксированный календарный план-график. Выплачиваем финансовую неустойку за каждый день просрочки.",
    caption: "ШТРАФ ЗА ДЕНЬ ЗАДЕРЖКИ",
  },
  {
    icon: "estimate",
    title: "Фиксированная смета",
    description: "Никаких внезапных доплат и скрытых коэффициентов. Финальная сумма утверждается до начала ремонта.",
    caption: "БЕЗ ДОПЛАТ ВО ВРЕМЯ РАБОТ",
  },
  {
    icon: "supervision",
    title: "Штатный технадзор",
    description: "3-ступенчатый контроль качества каждого скрытого узла, составление актов скрытых работ по СНиП.",
    caption: "ИНЖЕНЕРЫ С ДОПУСКОМ НРС",
  },
] as const;

const workSteps = [
  {
    icon: "consultation",
    title: "Бесплатная консультация и аудит",
    description: "Ответ инженера за 15 минут, предварительный расчет по вашим планировкам и техническому заданию.",
    note: "Срок: в день обращения",
  },
  {
    icon: "measurement",
    title: "Выезд инженера и лазерный замер",
    description: "Точный замер лазерным нивелиром, составление дефектной ведомости и осмотр состояния коммуникаций.",
    note: "Срок: выезд за 2 часа (Москва и МО)",
  },
  {
    icon: "estimate",
    title: "Детальная смета и договор",
    description: "Развернутая смета по позициям, график финансирования и утверждение твердой цены в официальном договоре.",
    note: "Срок: 1 рабочий день",
  },
  {
    icon: "delivery",
    title: "Поставка материалов и черновой цикл",
    description: "Оптовая закупка стройматериалов со скидкой, демонтаж, возведение перегородок, разводка труб и электрики.",
    note: "Оплата: после приёмки этапа",
  },
  {
    icon: "finishing",
    title: "Чистовая отделка и комплектация",
    description: "Укладка плитки, покраска стен по стандарту Q4, монтаж освещения, дверей, сантехфаянса и встраиваемой мебели.",
    note: "Контроль: фотоотчеты в WhatsApp",
  },
  {
    icon: "handover",
    title: "Приемка технадзором и сдача объекта",
    description: "Финальный клининг, подписание акта, передача полного пакета исполнительных схем и гарантийного сертификата.",
    note: "Гарантия 5 лет вступила в силу",
    success: true,
  },
] as const;

const faqEntries = [
  {
    question: "Сколько в среднем длится капитальный ремонт квартиры или офиса?",
    answer: "Квартира 60–90 м² занимает от 45 до 70 календарных дней. Офис 150–350 м² сдается за 30–50 дней благодаря посменной работе бригад. Сроки фиксируются в календарном графике договора.",
  },
  {
    question: "Можно ли заранее узнать точную стоимость без скрытых платежей?",
    answer: "Да, после выезда нашего инженера и проведения лазерного замера составляется смета со 100% детализацией. Цена фиксируется в договоре и не увеличивается в ходе выполнения работ.",
  },
  {
    question: "Какая гарантия предоставляется на выполненные работы?",
    answer: "Мы предоставляем официальную гарантию 5 лет на все общестроительные, отделочные и инженерные работы. Также объект страхуется в аккредитованной страховой компании на 50 000 000 ₽.",
  },
  {
    question: "Можем ли мы закупать черновые и чистовые материалы самостоятельно?",
    answer: "Да, вы можете приобретать материалы самостоятельно. Однако через нас закупка обычно обходится на 15–20% дешевле благодаря прямым дилерским скидкам производителей Knauf, Rehau и Schneider.",
  },
  {
    question: "Работаете ли вы официально с юридическими лицами (с НДС)?",
    answer: "Да, работаем как с физическими лицами, так и с юридическими компаниями (с НДС 20% или по УСН). Предоставляем полный комплект закрывающих документов КС-2 и КС-3, допуск СРО.",
  },
  {
    question: "Как организован порядок оплаты (нужен ли 100% аванс)?",
    answer: "Аванс за работы составляет 0 ₽. Оплата разделена на 4–6 этапов: вы принимаете выполненный объем по акту скрытых работ и качеству, и только после этого оплачиваете конкретный этап.",
  },
] as const;
---

<Layout title={companyName} lang="ru">
  <Header
    {companyName}
    {phone}
    {telegramUrl}
    schedule="Ежедневно с 9:00 до 21:00"
    license="Член СРО • Допуск № Г-0419"
    links={sections}
  />

  <main class="grid w-full flex-1 gap-24px py-32px">
    <h1 class="sr-only">{companyName}</h1>
    <WhyChooseUs
      title="Почему нас выбирают"
      eyebrow={"НАШИ СТАНДАРТЫ"}
      description="Каждый пункт договора составлен в пользу клиента с прозрачной системой финансовой ответственности"
      {advantages}
    />
    <WorkProcess
      eyebrow="ПРОЗРАЧНЫЙ ПРОЦЕСС"
      title="Поэтапный процесс реализации проекта"
      description="От первого звонка до подписания финального акта приёмки — понятный алгоритм без стресса для заказчика."
      oversight="6 шагов под контролем главного инженера"
      steps={workSteps}
    />
    <Faq
      eyebrow="ОТВЕТЫ НА ВОПРОСЫ"
      title="Часто задаваемые вопросы"
      description="Собрали ключевые моменты по договору, оплате, срокам и контролю качества."
      entries={faqEntries}
    />
  </main>

  <Footer {companyName} {phone} {email} sections={footerSections} />
</Layout>
