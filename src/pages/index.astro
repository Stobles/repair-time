---
import AboutCompany from "@/sections/About/AboutCompany.astro";
import Contacts from "@/sections/Contacts/Contacts.astro";
import Layout from "@/layouts/Layout.astro";
import Footer from "@/layouts/Footer.astro";
import Header from "@/layouts/Header/Header.astro";
import WhyChooseUs from "@/sections/WhyChooseUs/WhyChooseUs.astro";
import WorkProcess from "@/sections/WorkProcess/WorkProcess.astro";
import Reviews from "@/sections/Reviews/Reviews.astro";
import Faq from "@/sections/Faq/Faq.astro";
import Hero from "@/sections/Hero/Hero.astro";
import Portfolio from "@/sections/Portfolio/Portfolio.astro";
import Pricing from "@/sections/Pricing/Pricing.astro";
import { getPortfolioProjects } from "@/features/portfolio/server";
import { getPropertyTypes } from "@/features/contacts/server";
import { getFaqEntries } from "@/features/faq";
import { getReviews } from "@/features/reviews";
import { getPricingItems } from "@/features/pricing";
import { getSectionVisibility, sectionLabels } from "@/features/section-visibility/server";
import { baseHref } from "@/shared/lib/BasePath";

const isEnabled = await getSectionVisibility();
const [propertyTypes, faqEntries, reviews, pricingItems, portfolioProjects] = await Promise.all([
  getPropertyTypes(),
  isEnabled("faq") ? getFaqEntries() : [],
  isEnabled("reviews") ? getReviews() : [],
  isEnabled("pricing") ? getPricingItems() : [],
  isEnabled("portfolio") ? getPortfolioProjects() : [],
]);
const callbackForm = {
  propertyTypes,
  submitUrl: `${baseHref}api/callback-requests`,
};
const companyName = "Время ремонта";
const companyCity = "г. Донецк";
const companyRequisites = {
  proprietorName: "Иванов Иван Иванович",
  inn: "XXXXXXXXXXXX",
  ogrnip: "XXXXXXXXXXXXXXX",
  registrationAuthority: "Межрайонная ИФНС России № XX",
  isExample: true,
};
const phone = "+7 (949) 811 94 21";
const phoneNumber = phone.replace(/[^+\d]/g, "");
const whatsappUrl = `https://wa.me/${phoneNumber.replace(/\D/g, "")}`;
const telegramUrl = `https://t.me/${phoneNumber}`;
const email = "info@vremyaremonta.ru";
const visible = {
  hero: isEnabled("hero"),
  portfolio: portfolioProjects.length > 0,
  about: isEnabled("about"),
  whyChooseUs: isEnabled("why_choose_us"),
  workProcess: isEnabled("work_process"),
  pricing: pricingItems.length > 0,
  reviews: reviews.length > 0,
  faq: isEnabled("faq"),
  contacts: isEnabled("contacts"),
};
const navIds = ["portfolio", "about", "reviews", "faq", "contacts"] as const;
const visibleNavIds = navIds.filter((id) => visible[id]);
const headerLinks = visibleNavIds.map((id) => ({ id, label: id === "faq" ? "FAQ" : sectionLabels[id] }));
const footerLinks = visibleNavIds.map((id) => ({ id, label: id === "faq" ? "Ответы на частые вопросы" : sectionLabels[id] }));
const contactHref = visible.contacts ? "#contacts" : "#callback";
const advantages = [
  {
    icon: "warranty",
    title: "Гарантия 5 лет по договору",
    description: "Бесплатный оперативный выезд и устранение любых скрытых дефектов в течение 48 часов после обращения.",
    caption: "ОФИЦИАЛЬНЫЙ ПУНКТ ДОГОВОРА",
  },
  {
    icon: "schedule",
    title: "Соблюдение сроков до 1 дня",
    description: "Фиксированный календарный план-график. Выплачиваем финансовую неустойку за каждый день просрочки.",
    caption: "ШТРАФ ЗА ДЕНЬ ЗАДЕРЖКИ",
  },
  {
    icon: "estimate",
    title: "Фиксированная смета",
    description: "Никаких внезапных доплат и скрытых коэффициентов. Финальная сумма утверждается до начала ремонта.",
    caption: "БЕЗ ДОПЛАТ ВО ВРЕМЯ РАБОТ",
  },
  {
    icon: "supervision",
    title: "Штатный технадзор",
    description: "3-ступенчатый контроль качества каждого скрытого узла, составление актов скрытых работ по СНиП.",
    caption: "ИНЖЕНЕРЫ С ДОПУСКОМ НРС",
  },
] as const;

const workSteps = [
  {
    icon: "consultation",
    title: "Бесплатная консультация и аудит",
    description: "Ответ инженера за 15 минут, предварительный расчет по вашим планировкам и техническому заданию.",
    note: "Срок: в день обращения",
  },
  {
    icon: "measurement",
    title: "Выезд инженера и лазерный замер",
    description: "Точный замер лазерным нивелиром, составление дефектной ведомости и осмотр состояния коммуникаций.",
    note: "Выезд за 2 часа в Донецке и Мариуполе",
  },
  {
    icon: "estimate",
    title: "Детальная смета и договор",
    description: "Развернутая смета по позициям, график финансирования и утверждение твердой цены в официальном договоре.",
    note: "Срок: 1 рабочий день",
  },
  {
    icon: "delivery",
    title: "Поставка материалов и черновой цикл",
    description: "Оптовая закупка стройматериалов со скидкой, демонтаж, возведение перегородок, разводка труб и электрики.",
    note: "Оплата: после приёмки этапа",
  },
  {
    icon: "finishing",
    title: "Чистовая отделка и комплектация",
    description: "Укладка плитки, покраска стен по стандарту Q4, монтаж освещения, дверей, сантехфаянса и встраиваемой мебели.",
    note: "Контроль: фотоотчеты в WhatsApp",
  },
  {
    icon: "handover",
    title: "Приемка технадзором и сдача объекта",
    description: "Финальный клининг, подписание акта, передача полного пакета исполнительных схем и гарантийного сертификата.",
    note: "Гарантия 5 лет вступила в силу",
    success: true,
  },
] as const;

---

<Layout title={companyName} lang="ru">
  <Header
    {callbackForm}
    {companyName}
    {phone}
    {telegramUrl}
    schedule="Ежедневно с 9:00 до 21:00"
    license="Член СРО • Допуск № Г-0419"
    links={headerLinks}
  />

  <main class="flex flex-col w-full flex-1">
    <h1 id="hero-title" class="sr-only">Капитальный ремонт офисов и квартир</h1>
    {visible.hero && <Hero {contactHref} />}
    {visible.portfolio && <Portfolio projects={portfolioProjects} {contactHref} {whatsappUrl} />}
    {visible.about && <AboutCompany {contactHref} />}
    {visible.whyChooseUs && (
      <WhyChooseUs
        title="Почему нас выбирают"
        eyebrow={"НАШИ СТАНДАРТЫ"}
        description="Каждый пункт договора составлен в пользу клиента с прозрачной системой финансовой ответственности"
        {advantages}
      />
    )}
    {visible.workProcess && (
      <WorkProcess
        eyebrow="ПРОЗРАЧНЫЙ ПРОЦЕСС"
        title="Поэтапный процесс реализации проектов"
        description="От первого звонка до подписания финального акта приёмки — понятный алгоритм без стресса для заказчика."
        oversight="6 шагов под контролем главного инженера"
        steps={workSteps}
      />
    )}
    {visible.pricing && <Pricing items={pricingItems} {contactHref} />}
    {visible.reviews && (
      <Reviews
        eyebrow="РЕАЛЬНЫЙ ОПЫТ ЗАКАЗЧИКОВ"
        title="Отзывы о строительной компании «ВРЕМЯ РЕМОНТА»"
        description="Оценки нашей работы в Донецке и Мариуполе."
        {reviews}
      />
    )}
    {visible.faq && (
      <Faq
        eyebrow="ОТВЕТЫ НА ВОПРОСЫ"
        title="Часто задаваемые вопросы"
        description="Собрали ключевые моменты по договору, оплате, срокам и контролю качества."
        entries={faqEntries}
      />
    )}
    <Contacts
      showContactDetails={visible.contacts}
      {callbackForm}
      {phone}
      {email}
      {whatsappUrl}
      {telegramUrl}
      city={companyCity}
      schedule="Ежедневно с 09:00 до 21:00 без выходных"
    />
  </main>

  <Footer {companyName} {phone} {email} city={companyCity} sections={footerLinks} requisites={companyRequisites} />
</Layout>
