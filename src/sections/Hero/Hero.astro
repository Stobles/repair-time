---
import { HeroSlider } from "@/features/hero-slider";
import { getHeroSlides } from "@/features/hero-slider/api/getHeroSlides";
import Container from "@/shared/components/Container.astro";

interface Props {
  contactHref: string;
}

const { contactHref } = Astro.props;
const slides = await getHeroSlides();
---

{slides.length > 0 && (
  <section
    aria-labelledby="hero-title"
    class="bg-background-subtle pt-5 pb-32px max-sm:inset-ring-1 max-sm:inset-ring-border-default sm:pt-24px sm:max-l:border-b sm:max-l:border-border-default sm:max-l:pb-24px l:pb-48px"
  >
    <Container>
      <HeroSlider {slides} {contactHref} />
    </Container>
  </section>
)}
