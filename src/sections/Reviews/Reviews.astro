---
import { ReviewsSlider, getReviews } from "@/features/reviews";
import Container from "@/shared/components/Container.astro";

interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  description: string;
}

const { id = "reviews", eyebrow, title, description } = Astro.props;
const reviews = await getReviews();
const titleId = `${id}-title`;
---

<section
  {id}
  aria-labelledby={titleId}
  class="bg-background-subtle py-32px sm:max-l:border-b sm:max-l:border-border-default sm:max-l:py-24px l:border-t l:border-border-default l:py-20"
>
  <Container class="grid gap-16px sm:max-l:max-w-[calc(620px+2*var(--spacing-gutter-tablet))] l:gap-48px">
    <header class="grid gap-4px l:max-w-2xl l:gap-8px">
      <p class="flex items-center gap-8px text-tablet-title-extra-small text-text-accent l:text-desktop-title-extra-small">
        <span class="size-8px shrink-0 rounded-full bg-background-accent" aria-hidden="true"></span>
        {eyebrow}
      </p>
      <h2 id={titleId} class="text-tablet-h3 text-text-primary sm:max-l:text-tablet-h2 l:text-desktop-h2">
        {title}
      </h2>
      <p class="text-tablet-body-regular text-text-tertiary l:text-desktop-body-regular">
        {description}
      </p>
    </header>

    <ReviewsSlider {reviews} />
  </Container>
</section>
