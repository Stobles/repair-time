---
import Container from "@/shared/components/Container.astro";
import AccordionItem from "@/shared/ui/AccordionItem.astro";

interface FaqEntry {
  question: string;
  answer: string;
}

interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  description: string;
  entries: readonly FaqEntry[];
}

const { id = "faq", eyebrow, title, description, entries } = Astro.props;
const titleId = `${id}-title`;
---

<section
  {id}
  tabindex="-1"
  aria-labelledby={titleId}
  class="bg-background-base py-32px sm:max-l:border-b sm:max-l:border-border-default sm:max-l:py-48px l:border-t l:border-border-default l:py-20"
>
  <Container class="grid gap-16px sm:max-l:gap-32px l:gap-48px">
    <header class="grid gap-ui-gutter sm:justify-items-center sm:text-center sm:max-l:gap-8px l:gap-12px">
      <p class="flex items-center gap-8px text-tablet-title-small text-text-accent sm:max-l:text-tablet-title-extra-small l:text-desktop-title-extra-small">
        <span aria-hidden="true" class="hidden size-8px shrink-0 rounded-full bg-background-accent sm:block"></span>
        {eyebrow}
      </p>
      <h2 id={titleId} class="text-mobile-h2 text-text-primary sm:max-l:mt-4px sm:max-l:text-tablet-h2 l:text-desktop-h2">
        {title}
      </h2>
      <p class="hidden max-w-lg text-tablet-body-regular text-text-tertiary sm:block l:max-w-2xl l:text-desktop-body-regular">
        {description}
      </p>
    </header>

    <div class="mx-auto grid w-full max-w-5xl items-start gap-12px l:gap-24px">
      {entries.map(({ question, answer }, index) => (
        <AccordionItem
          number={String(index + 1).padStart(2, "0")}
          {question}
          size="compact"
          open={index === 0}
          class="min-w-0 l:bg-background-subtle"
        >
          <p>{answer}</p>
        </AccordionItem>
      ))}
    </div>
  </Container>
</section>
