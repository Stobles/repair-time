---
import { Check, X } from "lucide-astro";
import Badge from "@/shared/ui/Badge.astro";
import { Button } from "@/shared/ui/Button";
import type { PricingItem } from "@/features/pricing";

interface Props {
  item: PricingItem;
  titleId: string;
  contactHref: string;
}

const { item, titleId, contactHref } = Astro.props;
const unitLabels = {
  square_meter: "за м²",
  item: "за штуку",
  job: "за работу",
};
const price = new Intl.NumberFormat("ru-RU").format(item.priceFrom);
---

<article
  aria-labelledby={titleId}
  class:list={[
    "relative flex min-h-[320px] min-w-0 flex-col gap-16px rounded-xl border bg-background-subtle p-16px sm:max-l:min-h-[360px] l:min-h-[400px] l:p-24px",
    item.isFeatured ? "border-border-accent pt-24px shadow-md l:pt-32px" : "border-border-default shadow-xs",
  ]}
>
  {item.isFeatured && (
    <Badge variant="brand" class="absolute top-0 left-1/2 z-10 -translate-x-1/2 -translate-y-1/2 whitespace-nowrap">
      Популярно
    </Badge>
  )}
  <header class="grid justify-items-start gap-8px">
    <h3 id={titleId} class="text-mobile-h2 wrap-anywhere sm:max-l:text-tablet-h4 l:text-desktop-h4">
      {item.title}
    </h3>
    <p class="text-tablet-body-regular wrap-anywhere text-text-tertiary l:text-desktop-body-small">
      {item.description}
    </p>
  </header>

  <p class="flex flex-wrap items-baseline gap-x-4px gap-y-1 text-tablet-body-regular text-text-tertiary">
    <span>от</span>
    <span class:list={["min-w-0 text-mobile-h1 wrap-anywhere l:text-desktop-h3", item.isFeatured ? "text-text-accent" : "text-text-primary"]}>
      {price} ₽
    </span>
    <span>{unitLabels[item.priceUnit]}</span>
  </p>

  <ul role="list" class="grid gap-ui-gutter border-t border-border-default pt-16px l:gap-ui-inset">
    {item.features.map(({ label, unavailable }) => (
      <li class:list={[
        "flex min-w-0 items-start gap-ui-gutter text-tablet-body-regular l:text-desktop-body-small",
        unavailable ? "text-text-muted" : "text-text-secondary",
      ]}>
        {unavailable
          ? <X class="mt-0.5 size-4 shrink-0" aria-hidden="true" />
          : <Check class="mt-0.5 size-4 shrink-0 text-functional-success" aria-hidden="true" />}
        <span class="min-w-0 wrap-anywhere">
          {unavailable && <span class="sr-only">Не входит в стоимость. </span>}
          {label}
        </span>
      </li>
    ))}
  </ul>

  <Button
    href={contactHref}
    aria-describedby={titleId}
    variant={item.isFeatured ? "primary" : "outline"}
    size="medium"
    className="mt-auto h-auto min-h-ui-button-medium w-full whitespace-normal text-center"
  >
    Рассчитать стоимость
  </Button>
</article>
