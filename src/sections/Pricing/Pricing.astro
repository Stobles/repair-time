---
import { CircleHelp } from "lucide-astro";
import Container from "@/shared/components/Container.astro";
import { Button } from "@/shared/ui/Button";
import CardSlider from "@/shared/ui/CardSlider.astro";
import { getPricingItems } from "@/features/pricing";
import PricingCard from "./PricingCard.astro";

const items = await getPricingItems();
---

<section
  id="pricing"
  aria-labelledby="pricing-title"
  class="bg-background-base py-32px text-text-primary sm:max-l:border-b sm:max-l:border-border-default sm:max-l:py-24px l:border-t l:border-border-default l:py-20"
>
  <Container class="grid gap-16px sm:max-l:gap-24px l:gap-48px">
    <header class="grid gap-ui-gutter sm:justify-items-center sm:text-center l:gap-12px">
      <h2 id="pricing-title" class="text-mobile-h2 sm:max-l:text-tablet-h2 l:text-desktop-h2">Стоимость работ</h2>
      <p class="max-w-2xl text-tablet-body-regular text-text-tertiary l:text-desktop-body-regular">
        Указаны начальные цены. Точную стоимость уточним после оценки объёма работ.
      </p>
    </header>

    <CardSlider
      count={items.length}
      listClass={items.some(({ isFeatured }) => isFeatured) ? "pt-16px" : undefined}
      labels={{
        previous: "Предыдущая карточка",
        next: "Следующая карточка",
        item: "карточка",
        single: "Карточка",
        multiple: "Карточки",
      }}
    >
      {items.map((item, index) => (
        <li class="swiper-slide grid min-w-0 shrink-0">
          <PricingCard {item} titleId={`pricing-item-${index + 1}`} />
        </li>
      ))}
    </CardSlider>

    <div class="flex flex-wrap items-center justify-between gap-16px rounded-lg border border-border-default bg-background-subtle p-16px l:rounded-xl l:p-24px">
      <div class="grid min-w-0 flex-1 basis-md gap-4px">
        <h3 class="flex items-start gap-8px text-tablet-title-medium l:text-desktop-title-medium">
          <CircleHelp class="mt-0.5 size-4 shrink-0 text-text-accent" aria-hidden="true" />
          Что влияет на итоговую стоимость?
        </h3>
        <p class="text-tablet-body-regular text-text-tertiary l:text-desktop-body-small">
          Цена зависит от объёма и сложности работ, состояния объекта и выбранных материалов.
        </p>
      </div>
      <Button
        href="#contacts"
        variant="dark"
        size="medium"
        className="h-auto min-h-ui-button-medium w-full whitespace-normal text-center sm:w-auto"
      >
        Рассчитать стоимость
      </Button>
    </div>
  </Container>
</section>
